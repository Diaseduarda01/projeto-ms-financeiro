# Porta HTTP deste serviço
PORT=3360

# Banco de dados
DATABASE_URL=mysql://financeiro:financeiro@localhost:3306/ms_financeiro

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# AbacatePay
ABACATEPAY_API_KEY=abc_dev_xxxxxxxxxxxxxxxxxxxxxxxxxx
